<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080800">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000088"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="44dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECEPTOR"
                android:textColor="#FFD700"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShellStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● VERIFICANDO ACESSO"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#443300" />

        <!-- ABAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#00000066">

            <Button
                android:id="@+id/tabPermissao"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="PERMISSÃO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:background="@drawable/btn_clear"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabParear"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="PAREAR"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:background="@drawable/btn_clear"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabReplays"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="REPLAYS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:background="@drawable/btn_clear"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#181200" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- SECAO PERMISSAO -->
                <LinearLayout
                    android:id="@+id/secPermissao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pra copiar o replay recebido pra dentro do Free Fire, esse app precisa de acesso via Shizuku (ou root, se o aparelho tiver)."
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnAbrirShizuku"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="ABRIR / SOLICITAR SHIZUKU"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_primary"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <!-- SECAO PAREAR -->
                <LinearLayout
                    android:id="@+id/secParear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Informe o código gerado no app do PC/emulador pra parear os dois aparelhos."
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <EditText
                        android:id="@+id/etCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/input_bg"
                        android:hint="CÓDIGO DE 6 DÍGITOS"
                        android:textColorHint="#665500"
                        android:textColor="#FFD700"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:letterSpacing="0.15"
                        android:inputType="textCapCharacters"
                        android:maxLength="6"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                    <Button
                        android:id="@+id/btnParear"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="PAREAR DISPOSITIVO"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_primary"
                        android:stateListAnimator="@null"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/boxPareado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/input_bg"
                        android:padding="16dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● PAREADO COM O ENVIADOR"
                            android:textColor="#33CC55"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnDesparearRecv"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="DESPAREAR"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_secondary"
                            android:stateListAnimator="@null"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- SECAO REPLAYS -->
                <LinearLayout
                    android:id="@+id/secReplays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Se o PC mandou um replay enquanto o app estava fechado, ele aparece aqui assim que você abrir."
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnVerificarReplay"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="VERIFICAR REPLAY PENDENTE"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_primary"
                        android:stateListAnimator="@null" />

                    <TextView
                        android:id="@+id/tvSemReplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nenhum replay pendente no momento."
                        android:textColor="#665500"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

            </FrameLayout>

        </ScrollView>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#181200" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000088"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="root@receiver:~/ transfer_log"
                android:textColor="#00AA22"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#00000099"
            android:padding="12dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:lineSpacingExtra="2dp" />

        </ScrollView>

    </LinearLayout>

    <!-- OVERLAY AGUARDE -->
    <FrameLayout
        android:id="@+id/overlayAguarde"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminateTint="#FFD700"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/tvAguarde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AGUARDE..."
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="30dp"
                android:paddingEnd="30dp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
